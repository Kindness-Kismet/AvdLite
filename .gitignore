# Track reviewed source files, resources, and documentation through an allowlist.
*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/pyproject.toml
!/.github/
/.github/*
!/.github/workflows/
!/.github/workflows/*.yml
!/avdlite/
/avdlite/*
!/avdlite/*.py
!/resources/
/resources/*
!/resources/*.json
!/resources/*.xml
!/resources/*.sh
!/resources/*.rc
!/tests/
/tests/*
!/tests/*.py
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/*.xml
!/docs/
/docs/*
!/docs/*.md
